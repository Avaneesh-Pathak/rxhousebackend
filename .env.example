NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SITE_URL=http://localhost:5500
BACKEND_URL=http://localhost:3000
BLOG_TEMPLATE_URL=http://localhost:3000/blog-post.html

ENFORCE_HTTPS=false
# For production set ENFORCE_HTTPS=true behind your reverse proxy.

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Production requires a trusted reverse proxy that supplies X-Forwarded-Proto.
DATABASE_URL=postgres://postgres:1726@localhost:5432/rxhouse
# Optional persistent uploads directory, outside the application checkout.
UPLOAD_DIR=
# CORS_ORIGINS=https://pharmacies.doctor,https://www.pharmacies.doctor,http://localhost:5500,http://127.0.0.1:5500
ADMIN_PASSWORD=admin@1234
ADMIN_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_TOKEN_TTL_SECONDS=28800
ORDER_TAX_RATE=0.0825
ORDER_SHIPPING_FLAT=9.99
ORDER_FREE_SHIPPING_THRESHOLD=150
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
# EMAIL_TO defaults to SMTP_USER if left empty. Use a monitored order inbox.

# Optional verified Google business review feed (no random/fake reviews)
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=

# Pharmacies Doctor production environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Public URLs
SITE_URL=https://pharmacies.doctor
BACKEND_URL=https://pd.pharmacies.doctor
BLOG_TEMPLATE_URL=https://pd.pharmacies.doctor/blog-post.html

# PostgreSQL - never commit real credentials
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Persistent uploaded media. Keep this OUTSIDE the Git checkout.
UPLOAD_DIR=

# CORS origins, comma-separated
CORS_ORIGINS=https://pharmacies.doctor,https://www.pharmacies.doctor

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# Admin API authentication. Use a long unique password and a separate random secret.
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL_SECONDS=28800

# Server-authoritative order totals
ORDER_TAX_RATE=0.06
ORDER_SHIPPING_FLAT=0

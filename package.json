{
  "name": "rxhouse-backend",
  "version": "1.0.0",
  "description": "Standalone RxHouse backend API server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check catalog-pricing.js && node --check seo-renderer.cjs",
    "test": "node --test test/*.test.cjs",
    "prepare:seo": "node tools/prepare-seo.cjs",
    "cleanup:seo": "node tools/cleanup-legacy-seo.cjs",
    "build:seo": "node tools/build-seo.cjs",

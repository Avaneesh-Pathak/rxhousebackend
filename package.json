    "nodemailer": "^10.0.14",
    "pg": "^8.11.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5"
